{{- $entries := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $entries = $entries | append (dict "title" .Title "url" .RelPermalink "summary" (.Summary | plainify | truncate 180) "content" .Plain "tags" (.Params.tags | default slice) "date" (.Date.Format "Jan 02, 2006")) -}}
{{- end -}}
{{- $entries | jsonify -}}
